import datetime
import time
from influxdb_client import InfluxDBClient, Point
from influxdb_client.client.write_api import SYNCHRONOUS

# 1. Setup connection configuration
URL = "http://localhost:8086"       # Your InfluxDB URL (change if hosted remotely)
TOKEN = "YOUR_INFLUXDB_TOKEN"       # Your generated API token
ORG = "your_org_name"               # Your organization name
BUCKET = "your_bucket_name"         # Your bucket name

# 2. Initialize the client
client = InfluxDBClient(url=URL, token=TOKEN, org=ORG)
write_api = client.write_api(write_options=SYNCHRONOUS)

