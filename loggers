        # 3. Construct a time-series Point
        # Measurement = table name; Tag = indexed metadata; Field = actual values
        point = (
            Point("environment_metrics")
            .tag("location", "living_room")
            .field("temperature", current_temp)
            .field("humidity", current_humidity)
            .time(datetime.datetime.utcnow())
        )
        
